<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>System.Web.Services</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net40</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="wsdl-1.1.xsd" />
    <None Remove="wsdl-1.1-soap.xsd" />
    <None Remove="web-reference.xsd" />
    <EmbeddedResource Include="wsdl-1.1.xsd" LogicalName="wsdl-1.1.xsd" />
    <EmbeddedResource Include="wsdl-1.1-soap.xsd" LogicalName="wsdl-1.1-soap.xsd" />
    <EmbeddedResource Include="web-reference.xsd" LogicalName="web-reference.xsd" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration">
      <HintPath>../../android/assets/bin/Data/Managed/System.Configuration.dll</HintPath>
    </Reference>
    <Reference Include="System.EnterpriseServices">
      <HintPath>../../android/assets/bin/Data/Managed/System.EnterpriseServices.dll</HintPath>
    </Reference>
    <Reference Include="System.Xml">
      <HintPath>../../android/assets/bin/Data/Managed/System.Xml.dll</HintPath>
    </Reference>
    <Reference Include="System.Web">
      <HintPath>../../android/assets/bin/Data/Managed/System.Web.dll</HintPath>
    </Reference>
    <Reference Include="System.DirectoryServices">
      <HintPath>../../android/assets/bin/Data/Managed/System.DirectoryServices.dll</HintPath>
    </Reference>
    <Reference Include="System.Design">
      <HintPath>../../android/assets/bin/Data/Managed/System.Design.dll</HintPath>
    </Reference>
    <Reference Include="System.Data">
      <HintPath>../../android/assets/bin/Data/Managed/System.Data.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>