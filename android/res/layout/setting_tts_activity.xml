            <View android:visibility="gone" android:layout_width="match_parent" android:layout_height="@dimen/dp_8" />
            <TextView android:textSize="@dimen/dp_18" android:textColor="#333" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_16" android:text="左右滑动调节音调，建议在50左右" />
