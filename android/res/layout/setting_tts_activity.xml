                    <RadioButton android:textSize="@dimen/dp_20" android:textColor="@color/color_008aff_check" android:gravity="center" android:id="@id/speed60" android:tag="3" android:layout_width="wrap_content" android:layout_height="match_parent" android:button="@drawable/selector_choice" android:text=" 较快" android:layout_marginStart="@dimen/dp_15" android:layout_marginEnd="@dimen/dp_15" />
