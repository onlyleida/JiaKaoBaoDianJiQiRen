<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="@dimen/tt__main_padding" android:paddingEnd="@dimen/tt__main_padding"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:textSize="@dimen/tt__text_size_main_wait" android:textColor="#ff333333" android:id="@id/gz_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/tt__login_student_top_margin" android:text="学员登录" android:layout_centerHorizontal="true" />
    <LinearLayout android:orientation="horizontal" android:id="@id/gz_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp">
        <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/tt__back_top_img_width" android:layout_height="@dimen/tt__back_top_img_width" android:src="@drawable/tt__ic_top_left_back" android:scaleType="centerCrop" />
        <TextView android:textSize="@dimen/tt__back_top_text" android:textColor="#ff333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="返回" />
    </LinearLayout>
    <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:id="@id/gz_qr_code_layout" android:paddingTop="@dimen/rpx_70" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
        <TextView android:textSize="@dimen/text_32" android:textColor="#ff333333" android:id="@id/gz_app_qr_code_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="请使用 粤学车服务小程序 扫码登录" />
        <FrameLayout android:id="@id/btn_qr_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rpx_20">
            <ImageView android:id="@id/gz_app_qr_code" android:layout_width="@dimen/rpx_480" android:layout_height="@dimen/rpx_480" />
            <TextView android:textSize="@dimen/tt__text_size_qr_invalid" android:textColor="@android:color/white" android:gravity="center" android:id="@id/gz_invalid_app_qr_code" android:background="#7f000000" android:visibility="gone" android:layout_width="@dimen/rpx_480" android:layout_height="@dimen/rpx_480" android:text="二维码已失效，点击刷新" />
        </FrameLayout>
        <LinearLayout android:gravity="center" android:id="@id/gz_refresh_qrcode" android:background="@drawable/tt__bg_btn_blue_2_corner" android:layout_width="@dimen/rpx_270" android:layout_height="@dimen/rpx_80" android:layout_marginTop="@dimen/rpx_30">
            <TextView android:textSize="@dimen/text_32" android:textColor="@android:color/white" android:layout_gravity="center_vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="刷新二维码" android:drawablePadding="1.0dp" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
