<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:background="#fff" android:layout_width="match_parent" android:layout_height="match_parent">
        <FrameLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="@dimen/dp_18" android:textStyle="bold" android:textColor="#333" android:gravity="center" android:layout_gravity="center" android:id="@id/value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="@dimen/dp_30" android:text="0" />
            <Button android:layout_gravity="left|center" android:id="@id/finish" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_20" android:text="返回" />
        </FrameLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_30" android:layout_marginTop="@dimen/dp_10">
            <TextView android:textSize="@dimen/dp_16" android:textColor="#053eec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P挡 : " />
            <TextView android:textSize="@dimen/dp_16" android:textColor="#333" android:gravity="left" android:layout_gravity="center" android:id="@id/gp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_50" android:minWidth="@dimen/dp_500" android:text="0" />
            <Button android:id="@id/gpMake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="采集" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_30" android:layout_marginTop="@dimen/dp_10">
            <TextView android:textSize="@dimen/dp_16" android:textColor="#053eec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R挡 : " />
            <TextView android:textSize="@dimen/dp_16" android:textColor="#333" android:gravity="left" android:layout_gravity="center" android:id="@id/gr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_50" android:minWidth="@dimen/dp_500" android:text="0" />
            <Button android:id="@id/grMake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="采集" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_30" android:layout_marginTop="@dimen/dp_10">
            <TextView android:textSize="@dimen/dp_16" android:textColor="#053eec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N挡 : " />
            <TextView android:textSize="@dimen/dp_16" android:textColor="#333" android:gravity="left" android:layout_gravity="center" android:id="@id/gn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_50" android:minWidth="@dimen/dp_500" android:text="0" />
            <Button android:id="@id/gnMake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="采集" />
        </LinearLayout>
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_30" android:layout_marginTop="@dimen/dp_10">
            <TextView android:textSize="@dimen/dp_16" android:textColor="#053eec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="D挡 : " />
            <TextView android:textSize="@dimen/dp_16" android:textColor="#333" android:gravity="left" android:layout_gravity="center" android:id="@id/gd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_50" android:minWidth="@dimen/dp_500" android:text="0" />
            <Button android:id="@id/gdMake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="采集" />
        </LinearLayout>
        <TextView android:textSize="@dimen/dp_25" android:textStyle="bold|italic" android:textColor="#af20" android:layout_gravity="center_horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/dp_30" android:text="请将档位挂好后，等待5秒钟，点击采集" android:shadowDx="3.0" android:shadowDy="3.0" android:shadowRadius="3.0" />
    </LinearLayout>
</FrameLayout>
