<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:orientation="horizontal" android:background="@drawable/tt__bg_round_white" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include android:id="@id/mountain" layout="@layout/tt__include_bottom_mountain" />
    <include android:id="@id/gzStudent" layout="@layout/tt__layout_student_qrcode" />
    <RelativeLayout android:id="@id/rlLayout" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="@dimen/tt__main_padding" android:paddingEnd="@dimen/tt__main_padding">
        <TextView android:textSize="@dimen/tt__text_size_main_wait" android:textColor="#ff333333" android:id="@id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/tt__login_student_top_margin" android:text="学员登录" android:layout_centerHorizontal="true" />
        <TextView android:textSize="@dimen/tt__text_size_insert_ic_tip" android:textColor="#ff222222" android:id="@id/inert_ic_card_tip" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/tt__login_input_gap_small" android:text="请插卡" android:layout_below="@id/title" />
        <EditText android:textSize="@dimen/tt__text_size_input" android:textColor="#ff333333" android:textColorHint="#ffa0a0a0" android:id="@id/id_card_number" android:background="@drawable/tt__bg_input" android:paddingLeft="10.0dp" android:paddingRight="10.0dp" android:focusable="false" android:layout_width="@dimen/tt__login_input_width_small" android:layout_height="@dimen/tt__input_height_small" android:layout_marginTop="@dimen/tt__login_input_gap_small" android:hint="输入手机号或证件号进行登录" android:maxLines="1" android:maxLength="18" android:layout_below="@id/title" />
        <TextView android:textSize="@dimen/tt__text_size_button" android:textColor="#ffffffff" android:gravity="center" android:id="@id/login" android:background="@drawable/tt__bg_btn_blue_2_corner" android:layout_width="@dimen/tt__button_width_small" android:layout_height="@dimen/tt__button_height_small" android:layout_marginTop="@dimen/tt__login_input_gap_small" android:text="登录" android:layout_below="@id/id_card_number" />
        <LinearLayout android:gravity="center_horizontal" android:orientation="vertical" android:id="@id/qr_code_layout" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/tt__login_top_margin_small" android:layout_below="@id/login" android:layout_marginStart="@dimen/tt__qr_start_margin" android:layout_alignParentStart="true">
            <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content">
                <ImageView android:id="@id/app_qr_code" android:layout_width="@dimen/tt__qr_size_small" android:layout_height="@dimen/tt__qr_size_small" />
                <TextView android:textSize="@dimen/tt__text_size_qr_invalid_small" android:textColor="@android:color/white" android:gravity="center" android:id="@id/invalid_app_qr_code" android:background="#7f000000" android:visibility="gone" android:layout_width="@dimen/tt__qr_size_small" android:layout_height="@dimen/tt__qr_size_small" android:text="二维码已失效，点击重新生成" />
            </FrameLayout>
            <TextView android:textSize="@dimen/tt__text_size_qr_invalid_small" android:textColor="#ff333333" android:id="@id/app_qr_code_tip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10.0dp" android:text="请使用 驾考宝典 或 教练宝典 扫码登录" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:id="@id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16.0dp">
            <ImageView android:layout_gravity="center_vertical" android:layout_width="@dimen/tt__back_top_img_width" android:layout_height="@dimen/tt__back_top_img_width" android:src="@drawable/tt__ic_top_left_back" android:scaleType="centerCrop" />
            <TextView android:textSize="@dimen/tt__back_top_text" android:textColor="#ff333333" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="返回" />
        </LinearLayout>
        <LinearLayout android:orientation="vertical" android:layout_width="@dimen/tt__login_record_width" android:layout_height="match_parent" android:layout_marginTop="@dimen/tt__login_input_gap_small" android:layout_marginBottom="14.0dp" android:layout_below="@id/title" android:layout_alignParentEnd="true">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/tt__bg_top_blue_2_corner" android:layout_width="match_parent" android:layout_height="@dimen/tt__input_height_small" android:paddingStart="@dimen/tt__login_record_padding" android:paddingEnd="@dimen/tt__login_record_padding">
                <TextView android:textSize="@dimen/tt__back_top_text" android:textColor="#ff222222" android:padding="4.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="登录记录" />
                <View android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0" />
                <TextView android:textSize="@dimen/tt__back_top_text_small" android:textColor="#ff078dfe" android:gravity="end" android:id="@id/clearRecord" android:padding="4.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清除所有记录" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@id/recyclerView" android:layout_width="match_parent" android:layout_height="wrap_content" android:overScrollMode="never" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
