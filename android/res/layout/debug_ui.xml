<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content">
        <Button android:id="@id/start" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开始" />
        <Button android:id="@id/stop" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="停止" />
        <Button android:id="@id/forward" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="前进" />
        <Button android:id="@id/backward" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="后退" />
        <Button android:id="@id/turnLeft" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="左转弯" />
        <Button android:id="@id/turnRight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="右转弯" />
        <Button android:id="@id/turnUp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="上坡" />
        <Button android:id="@id/turnDown" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="下坡" />
    </LinearLayout>
</ScrollView>
