<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@drawable/shape_privacy_agreement" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <TextView android:id="@id/app_name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/privacy_agreement_content" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="\n我们非常重视用户的隐私和个人信息保护，希望您仔细阅读《隐私政策》和《用户服务协议》，详细了解我们对信息的收集、使用方式、以便您更好地了解我们的服务并作出适当的选择。如您同意隐私政策和用户服务协议，请点击“同意并使用”并开始使用我们的产品及服务。若点击“放弃并退出”，则相关服务不可用\n" style="@style/privacy_agreement_content" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/dp_0" android:text="点击查看完整的" style="@style/privacy_agreement_content" />
        <TextView android:textColor="#008aff" android:id="@id/privacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_0" android:layout_marginRight="@dimen/dp_0" android:text="《隐私政策》" style="@style/privacy_agreement_content" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_0" android:layout_marginRight="@dimen/dp_0" android:text="和" style="@style/privacy_agreement_content" />
        <TextView android:textColor="#008aff" android:id="@id/agreement" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/dp_0" android:layout_marginRight="@dimen/dp_0" android:text="《用户服务协议》" style="@style/privacy_agreement_content" />
    </LinearLayout>
</LinearLayout>
