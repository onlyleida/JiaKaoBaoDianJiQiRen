<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/dp_14" />
            <solid android:color="#fff" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <gradient android:startColor="#ff0095ff" android:endColor="#ff33aaff" android:useLevel="true" android:angle="90.0" android:type="linear" />
                        <corners android:radius="@dimen/dp_14" />
                    </shape>
                </item>
                <item android:id="@android:id/secondaryProgress" android:drawable="@drawable/process_bg1" />
            </layer-list>
        </clip>
    </item>
</layer-list>
