<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="3.0dp" />
            <solid android:color="#f5f5f5" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip android:gravity="left" android:clipOrientation="horizontal">
            <shape>
                <gradient android:startColor="#ff0095ff" android:endColor="#ff33aaff" android:useLevel="true" android:angle="90.0" android:type="linear" />
                <corners android:radius="3.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
