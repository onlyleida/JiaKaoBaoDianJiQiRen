<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/rpx_9" />
            <solid android:color="#a0ffffff" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:topLeftRadius="@dimen/rpx_9" android:bottomLeftRadius="@dimen/rpx_9" />
                <solid android:color="#3d95f5" />
            </shape>
        </clip>
    </item>
</layer-list>
